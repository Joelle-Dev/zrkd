{
  "name": "zhirikede",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "指日可待 · 一天一天，等到那天",
  "scripts": {
    "dev": "vite",
    "build": "vite build && touch dist/.nojekyll",
    "build:docs": "npm run build && rm -rf docs && cp -R dist docs && touch docs/.nojekyll",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "cert": "node scripts/make-cert.mjs",
    "dev:lan": "VITE_HTTPS=1 vite --host",
    "preview:lan": "VITE_HTTPS=1 vite preview --host",
    "test": "node --test tests/*.test.js",
    "native:sync": "vite build && cap sync",
    "ios": "vite build && cap sync ios && cap open ios",
    "android": "vite build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "lunar-javascript": "^1.7.8",
    "vant": "^4.10.2",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "fake-indexeddb": "^6.2.8",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0"
  },
  "engines": {
    "node": ">=22"
  }
}
